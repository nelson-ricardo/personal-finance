# ==============================================================================
# Personal Budgeting App Environment Configuration
# ==============================================================================

# Operational Mode: 'dev' or 'prod'
APP_ENV=dev

# Target database: 'budget_app_dev' for dev, 'budget_app_prod' for prod
DB_NAME=budget_app_dev

# Build targets for Dockerfile: 'dev' or 'prod'
BACKEND_TARGET=dev
FRONTEND_TARGET=dev

# Frontend port: 5173 for dev (Vite), 3000 for prod (Node adapter)
FRONTEND_PORT=5173

# PostgreSQL Credentials
POSTGRES_USER=budgeter
POSTGRES_PASSWORD=budgeter_password
DB_PORT=5432
